FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    bash coreutils procps iproute2 net-tools \
    vim nano curl wget htop less findutils \
    postgresql-client python3 openssh-client \
    dnsutils traceroute nmap whois file \
    inotify-tools jq tree unzip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash -u 1001 admin && \
    useradd -m -s /bin/bash -u 1002 dba_user && \
    useradd -m -s /bin/bash -u 1003 ahmet && \
    echo "root:toor" | chpasswd && \
    echo "admin:12345" | chpasswd && \
    echo "ahmet:Ahmet2024!" | chpasswd

RUN echo "prod-db-01" > /etc/hostname || true

RUN mkdir -p /root/.ssh && \
    ssh-keygen -t rsa -b 2048 -f /root/.ssh/id_rsa -N "" -q && \
    echo "Host backup-srv" > /root/.ssh/config && \
    echo "    HostName 192.168.1.10" >> /root/.ssh/config && \
    echo "    User admin" >> /root/.ssh/config

RUN mkdir -p /var/spool/cron/crontabs && \
    echo "0 2 * * * /usr/local/bin/backup.sh >> /var/log/backup.log 2>&1" > /var/spool/cron/crontabs/root || true

RUN mkdir -p /usr/local/bin && \
    printf '#!/bin/bash\npg_dump -U postgres finansbank_prod > /tmp/backup.sql\n' > /usr/local/bin/backup.sh && \
    chmod +x /usr/local/bin/backup.sh

RUN mkdir -p /etc/systemd/system && \
    printf '[Unit]\nDescription=PostgreSQL 14\n[Service]\nExecStart=/usr/bin/pg_ctlcluster 14 main start\n' > /etc/systemd/system/postgresql.service

RUN mkdir -p /var/log/postgresql /var/log/nginx /var/log/redis

COPY decoy/bash_history /root/.bash_history
COPY decoy/passwords.txt /root/passwords.txt
COPY decoy/config.php /root/config.php
COPY decoy/todo.txt /root/todo.txt
COPY decoy/auth.log /var/log/auth.log
COPY decoy/postgresql.conf /etc/postgresql/postgresql.conf
COPY decoy/id_rsa /root/backup_key.pem
COPY decoy/.env /root/.env
COPY decoy/backup_db.sql /tmp/backup_20240115.sql
RUN mkdir -p /root/.aws
COPY decoy/aws_credentials /root/.aws/credentials

COPY scripts/canary_watcher.sh /usr/local/bin/canary_watcher.sh
COPY scripts/entrypoint.sh /usr/local/sbin/.entrypoint.sh
RUN chmod +x /usr/local/sbin/.entrypoint.sh /usr/local/bin/canary_watcher.sh

RUN printf '2024-01-14 03:15:22 UTC LOG: database system is ready\n2024-01-15 02:10:35 UTC PANIC: No space left on device\n' > /var/log/postgresql/postgresql-14-main.log

RUN printf '192.168.1.50 - - [14/Jan/2024:10:22:15 +0000] "GET /admin/login HTTP/1.1" 200 3421\n' > /var/log/nginx/access.log

# Login banner
RUN echo "Welcome to Ubuntu 22.04.3 LTS (GNU/Linux 5.15.0-91-generic x86_64)" > /etc/motd && \
    echo "" >> /etc/motd && \
    echo " * System load:  0.42   Processes:           142" >> /etc/motd && \
    echo " * Memory usage: 78%    IPv4 address: 192.168.1.100" >> /etc/motd && \
    echo "" >> /etc/motd

WORKDIR /root

ENTRYPOINT ["/usr/local/sbin/.entrypoint.sh"]
CMD ["/bin/bash", "-li"]
