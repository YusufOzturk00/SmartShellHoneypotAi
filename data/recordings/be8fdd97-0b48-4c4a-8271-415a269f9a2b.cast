[95.622685, "o", "\u001b[35m\u001b[K/etc/pam.d/newusers\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K@include common-\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/pam.d/common-password\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# /etc/pam.d/common-\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K - \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K-related modules common to all services\r\n\u001b[35m\u001b[K/etc/pam.d/common-password\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# used to change user \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks.  The default is pam_unix.\r\n\u001b[35m\u001b[K/etc/pam.d/common-password\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#hashed \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks using the yescrypt algorithm, introduced in Debian\r\n\u001b[35m\u001b[K/etc/pam.d/common-password\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#used the option \"sha512\"; if a shadow \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K hash will be shared\r\n\u001b[35m\u001b[K/etc/pam.d/common-password\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\t[success=1 default=ignore]\tpam_unix.so obscure yescrypt\r\n\u001b[35m\u001b[K/etc/pam.d/common-password\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\trequisite\t\t\tpam_deny.so\r\n\u001b[35m\u001b[K/etc/pam.d/common-password\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\trequired\t\t\tpam_permit.so\r\n\u001b[35m\u001b[K/etc/pam.d/su-l\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\tinclude\t\tsu\r\n\u001b[35m\u001b[K/etc/pam.d/chfn\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# prompted for a \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/pam.d/other\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K@include common-\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/pam.d/login\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K@include common-\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/pam.d/chpasswd\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K@include common-\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/pam.d/passwd\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K@include common-\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/pam.d/chsh\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# prompted for a \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n"]
[95.624487, "o", "\u001b[35m\u001b[K/etc/pam.d/su\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# This allows root to su without \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks (normal operation)\r\n\u001b[35m\u001b[K/etc/pam.d/su\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# su without a \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K.\r\n\u001b[35m\u001b[K/etc/debconf.conf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# World-readable, and accepts everything but \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks.\r\n\u001b[35m\u001b[K/etc/debconf.conf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KReject-Type: \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/debconf.conf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# Not world readable (the default), and accepts only \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks.\r\n\u001b[35m\u001b[K/etc/debconf.conf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KName: \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks\r\n\u001b[35m\u001b[K/etc/debconf.conf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KAccept-Type: \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/debconf.conf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KFilename: /var/cache/debconf/\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks.dat\r\n\u001b[35m\u001b[K/etc/debconf.conf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# databases, one to hold \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks and one for everything else.\r\n\u001b[35m\u001b[K/etc/debconf.conf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KStack: config, \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks\r\n\u001b[35m\u001b[K/etc/debconf.conf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# A remote LDAP database. It is also read-only. The \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K is really\r\n\u001b[35m\u001b[K/etc/default/useradd\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# The number of days after a \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K expires until the account \r\n"]
[95.626902, "o", "\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#\tPASS_MAX_DAYS\tMaximum number of days a \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K may be used.\r\n"]
[95.62792, "o", "\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#\tPASS_MIN_DAYS\tMinimum number of days allowed between \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K changes.\r\n\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#\tPASS_WARN_AGE\tNumber of days warning given before a \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K expires.\r\n\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# Max number of login retries if \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K is bad. This will most likely be\r\n\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# If set to \"yes\", new \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks will be encrypted using the MD5-based\r\n\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# It supports \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks of unlimited length and longer salt strings.\r\n\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# Set to \"no\" if you need to copy encrypted \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks to other systems\r\n\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# If set to MD5 , MD5-based algorithm will be used for encrypting \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# If set to SHA256, SHA256-based algorithm will be used for encrypting \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# If set to SHA512, SHA512-based algorithm will be used for encrypting \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# If set to DES, DES-based algorithm will be used for encrypting \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K (default)\r\n\u001b[35m\u001b[K/etc/login.defs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# With a lot of rounds, it is more difficult to brute forcing the \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K.\r\n"]
[95.721651, "o", "\u001b[35m\u001b[K/etc/ssl/openssl.cnf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# input_\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K = secret\r\n\u001b[35m\u001b[K/etc/ssl/openssl.cnf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# output_\u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K = secret\r\n\u001b[35m\u001b[K/etc/ssl/openssl.cnf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KchallengePassword\t\t= A challenge \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K\r\n"]
[95.722615, "o", "\u001b[35m\u001b[K/etc/services\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kshell\t\t514/tcp\t\tcmd syslog\t# no \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[Ks used\r\n"]
