0000\u0000\u0000\u0000\u0000\u0000\u0000Option parse error for TOps response %d from %s.\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000Bogus line #%d (%s) passed to %s()\u0000\u0000\u0000\u0000\u0000\u0000Parse error on line %d of fingerprint: %s\r\n\u0000\u0000\u0000\u0000\u0000\u0000\"CPE\" line without preceding \"Class\" at line %d\u0000void parse_cpeline(FingerPrint*, char*, int)\u0000\u0000\u0000\u0000const char* string_pool_sprintf(const char*, ...)\u0000\u0000\u0000\u0000\u0000\u0000\u0000bool HostOsScan::processTWinResp(HostOsScanStats*, tcp_hdr*, int)\u0000\u0000\u0000\u0000\u0000\u0000\u0000Option parse error for ECN response from %s.\u0000\u0000\u0000\u0000bool HostOsScan::processTEcnResp(HostOsScanStats*, ip*)\u0000p + 1 < quirks_buf + sizeof(quirks_buf)\u0000bool HostOsScan::processTIcmpResp(HostOsScanStats*, ip*, int)\u0000\u0000\u0000icmp1->icmp_type == 0 && icmp2->icmp_type == 0\u0000\u0000Parse error with AVal string (%s) in nmap-os-db file\u0000\u0000\u0000\u0000Probe doesn't exist! Probe type: %d. Probe subid: %d\r\n\u0000\u0000\u0000OS detection timingRatio() == (%.3f - %.3f) * 1000 / %d == %.3f\r\n\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000double compare_fingerprints(const FingerPrint*, const FingerPrint*, const FingerPrint*, int)\u0000\u0000\u0000\u0000strcmp(prev_ref->name, current_ref->name) < 0\u0000\u0000\u0000strcmp(prev_fp->name, current_fp->name) < 0\u0000\u0000\u0000\u0000\u0000int AVal_match(const FingerTest*, const FingerTest*, const FingerTest*, long unsigned int*, long unsigned int*, int, int)\u0000\u0000\u0000\u0000\u0000\u0000\u0000strcmp(prev_ref->attribute, current_ref->attribute) < 0\u0000strcmp(prev_fp->attribute, current_fp->attribute) < 0\u0000\u0000\u0000%s: Failed to find point amount for test %s.%s\u0000\u0000%s: Got bogus point amount (%s) for test %s.%s\u0000\u0000%s.%s: \"%s\" NOMATCH \"%s\" (%d %s)\r\n\u0000\u0000\u0000\u0000\u0000\u0000\u0000num_subtests_succeeded <= num_subtests\u0000\u0000%s: Failed to locate test %s in MatchPoints directive of fingerprint file\u0000\u0000\u0000\u0000\u0000\u0000\u0000void match_fingerprint(const FingerPrint*, FingerPrintResultsIPv4*, const FingerPrintDB*, double)\u0000\u0000\u0000\u0000\u0000\u0000\u0000accuracy_threshold >= 0 && accuracy_threshold <= 1\u0000\u0000\u0000\u0000\u0000\u0000Bogus list insertion state (%d) -- num_matches = %d num_perfect_matches=%d entrance_requirement=%f\u0000\u0000\u0000\u0000\u0000\u0000dst host %s and (icmp or (tcp and (%s\u0000\u0000\u0000First choice open TCP port %d is tcpwrapped. \u0000\u0000\u0000All open TCP ports are found to be tcpwrapped. Using %d for OS detection, but results might not be accurate.\r\n\u0000\u0000\u0000Using non-tcpwrapped port %d for OS detection.\r\n\u0000void HostOsScan::adjust_times(HostOsScanStats*, OFProbe*, timeval*)\u0000\u0000\u0000\u0000\u0000OS scan DROPPED probe to %s detected (tryno %d)\r\n\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000OS scan DROPPED probe to %s detected (rcvdtime == NULL)\r\n\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000void HostOsScan::sendTSeqProbe(HostOsScanStats*, int)\u0000\u0000\u0000probeNo >= 0 && probeNo < NUM_SEQ_SAMPLES\u0000\u0000\u0000\u0000\u0000\u0000\u0000void HostOsScan::sendTOpsProbe(HostOsScanStats*, int)\u0000\u0000\u0000void HostOsScan::sendTEcnProbe(HostOsScanStats*)\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000void HostOsScan::sendT1_7Probe(HostOsScanStats*, int)\u0000\u0000\u0000void HostOsScan::sendTIcmpProbe(HostOsScanStats*, int)\u0000\u0000%s: One or more of your parameters suck!\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000void HostOsScan::sendTUdpProbe(HostOsScanStats*, int)\u0000\u0000\u0000void HostOsScan::sendNextProbe(HostOsScanStats*)\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000Send probe (type: %s, subid: %d) to %s\r\n\u0000bool HostOsScan::processTUdpResp(HostOsScanStats*, ip*)\u0000icmp->icmp_type == 3 && icmp->icmp_code == 3\u0000\u0000\u0000\u0000Insufficient responses from %s for TCP sequencing (%d), OS detection may be less accurate\r\n\u0000\u0000\u0000\u0000\u0000\u0000Ignoring claimed %s uptime of %lld days\r\n\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000void HostOsScan::makeFP(HostOsScanStats*)\u0000\u0000\u0000\u0000\u0000\u0000\u0000bool HostOsScan::processTSeqResp(HostOsScanStats*, ip*, int)\u0000\u0000\u0000\u0000replyNo >= 0 && replyNo < NUM_SEQ_SAMPLES\u0000\u0000\u0000\u0000\u0000\u0000\u0000WARNING: RST from %s port %d -- is this port really open?\u0000\u0000\u0000\u0000\u0000\u0000\u0000Unable to associate os scan response with sent packet for %s.\u0000\u0000\u0000Received ack: %lX; sequence sent: %lX. Packet:\u0000\u0000bool HostOsScan::processT1_7Resp(HostOsScanStats*, ip*, int)\u0000\u0000\u0000\u0000Option parse error for T%d response from %s.\u0000\u0000\u0000\u0000Got a valid response for probe (type: %s subid: %d) from %s\r\n\u0000\u0000\u0000\u0000bool HostOsScan::processResp(HostOsScanStats*, ip*, unsigned int, timeval*)\u0000\u0000\u0000\u0000\u0000Skipping OS Scan against %s due to absence of open (or perhaps closed) ports\r\n\u0000\u0000\u0000Completed os scan against %s in %.3fs (%d %s)\r\n\u0000\u0000%s timed out during os scan (%d %s)\r\n\u0000\u0000\u0000\u0000SCAN(V=%s%%E=%s%%D=%d/%d%%OT=%s%%CT=%s%%CU=%s%%PV=%c%s%s%%G=%c%s%%TM=%X%%P=%s)\u0000\u0000const char* mergeFPs(FingerPrint**, int, bool, const sockaddr_storage*, int, dist_calc_method, const u8*, int, int, int, bool)\u0000\u0000The test %s was somehow lost in %s.\r\n\u0000\u0000\u0000\u0000Merged fingerprint too long in %s.\r\n\u0000\u0000\u0000\u0000\u0000%s OS detection (try #%d) against %s\r\n\u0000\u0000\u0000Sleep %dus for next sequence probe\r\n\u0000\u0000\u0000\u0000\u0000Host %s. ProbesToSend %d: \tProbesActive %d\r\n\u0000\u0000\u0000\u0000\u0000WARNING: OS didn't match until try #%d\r\n\u0000No OS matches for %s by new os scan system.\r\n\r\nTCP/IP fingerprint:\r\n%s\u0000\u0000\u0000\u0000\u0000cannot create std::vector larger than max_size()\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000Parse error line #%d of fingerprint: %s\u0000Parse error on line %d of fingerprint: %s\u0000\u0000\u0000\u0000\u0000\u0000\u0000Unable to open Nmap fingerpri"]
