[53.482005, "o", "\u0000\u0000\ufffd\ufffd\u0001\u0004\u0011\u0005\u0000\u0000\u0000\u0000\u0000\ufffd\ufffd%\u0001\u0018\ufffd\u0001\u0005\ufffd\u0005\u0001\ufffd\u0001\u0005\ufffd\u0005\u0003\ufffd\u0002\u0005\ufffd\u0005\u0003\ufffd\u0002\u0005\ufffd\u0004\u0003\u0001\u0000\u0000}\u0000\u0000\u0000\u0000\u0000\u0000\u0000\ufffd\ufffd\u0015\u0001\b^\u0005c\u0000r\u0005\u0000\u0000\u0001\u0000\u0000}\u0000\u0000\u0000\u0000\u0000\u0000\u0000\ufffd\ufffd\r\u0001\u0005U\u0005\ufffd\u0001\u0001\u0001\u0000\u0000\u0000\u0000\u0000\ufffd\ufffd\u0011\u0001\b'\u0005,\u0000;\u0005\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\ufffd\ufffd\u0011\u0001\u0007\ufffd\u0001\ufffd\u0001\ufffd\u0003\u0001\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\ufffd\ufffd\u0011\u0001\b9\u0005>\u0000k\u0005\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\ufffd\ufffd\u0001$\ufffd\u0001\u0005\ufffd\u0007\u0000\ufffd\u0003\u0005\ufffd\u0006\u0000\ufffd\u0003E\ufffd\u0006\u0000\ufffd\u0004\u0005\ufffd\u0006\u0000\ufffd\u0004\u0005\ufffd\u0006\u0000\ufffd\u0006\u0005\ufffd\u0006\u0000\ufffd\ufffd\u0001\u0004\u0013E\u0000\u0000\ufffd\ufffd\u0001\u0016Q\u0018\u0000\u0000\ufffd\u0001\u0005\ufffd\u0003\u0000\ufffd\u0001\u0005\ufffd\u0003\u0000\ufffd\u0001\u0005\ufffd\u0003\u0000\ufffd\ufffd\u0001\u0004\u001e\u0005\u0000\u0000\u0000\u0000\ufffd\ufffd\u0015\u0001\r\n \u0005\u0000\u0000\ufffd\u0001\u0005\ufffd\u0003\u0003\u0001\u0000\u0000}\u0000\u0000\u0000\u0000\u0000\ufffd\ufffd\u0015\u0001\b\u001d\u0005\"\u00001\u0005\u0000\u0000\u0001\u0000\u0000}\u0000\u0000\u0000\u0000\u0000\u0000\u0000\ufffd\ufffd\u0001\u0000\ufffd\ufffd\u0001\u0019\ufffd\u0001\ufffd\u0001\ufffd\r\n\u0000\ufffd\u0004\u0005\ufffd\r\n\u0000\ufffd\u0004\u0005\ufffd\r\n\u0000\ufffd\u0007\u0005\ufffd\r\n\u0000\ufffd\ufffd\u0001\u0004(\u0005\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u